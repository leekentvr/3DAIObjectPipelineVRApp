# This .gitignore is written for Unity projects and matches Unity's official template
# (https://github.com/github/gitignore/blob/main/Unity.gitignore) plus a couple of
# project-specific entries at the bottom.

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Ll]ibrary/BuildPlayerData/*/[Aa]ssets/*.meta

# Autogenerated VS/Rider/MD/Consulo solution and project files
.vs/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packages lock file (uncomment to always resolve fresh; usually you WANT this committed)
# /Packages/packages-lock.json

# Unity incremental player-build cache (IL2CPP/CMake/ninja intermediates)
/.utmp/

# --- Project-specific ---
# Local pipeline server connection (LAN address + optional API token). This file lives
# at Application.persistentDataPath at runtime, NOT inside this repo, so it never
# actually appears here -- this entry is just a safety net in case a copy ever ends up
# in the working tree during on-device debugging (e.g. via adb pull).
pipeline-config.json
pipeline-config.local.json
